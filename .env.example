# Server port
PORT=8470

# OpenAI API key (needs Realtime API access)
OPENAI_API_KEY=sk-proj-your-key-here

# Slack Bot Token (your AI assistant bot — xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack User Token (User app — posts voice transcripts as you — xoxp-)
SLACK_USER_TOKEN=xoxp-your-user-token

# Basic Auth for the web UI
AUTH_USER=yourname
AUTH_PASS=change-this-to-something-secure
